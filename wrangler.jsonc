{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "resetwatch-ingest",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-17",
	"workers_dev": false,
	"preview_urls": false,
	"triggers": { "crons": ["*/5 * * * *"] },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "resetwatch",
			"database_id": "9b069aa9-30a5-4f9a-bc05-72be9e0501ec"
		}
	],
	"ai": { "binding": "AI" },
	"vars": {
		"FEED_URL": "https://store.steampowered.com/feeds/news/app/2357570/"
	},
	"observability": { "enabled": true }
}
